#!/usr/bin/env bash
# Build-time checks for the {{ dashboard_title }} image.
#
# Every feature of this app is exercised once while the image is built, so a
# broken image fails its build rather than failing in front of a workshop.
# Generated by training-environment-app-creator.
set -euo pipefail

ok() { echo "smoke-test: ok - $*"; }
fail() {
    echo "smoke-test: FAILED - $*" >&2
    exit 1
}

work="$(mktemp -d)"
trap 'rm -rf "${work}"' EXIT
{% if slurm.enabled %}

# wait for a job of the Slurm emulator to finish, and print how it ended
wait_for_job() {
    local state=""
    for _ in $(seq 1 240); do
        state="$(sacct -n -j "$1" | awk '{print $6}')"
        case "${state}" in COMPLETED | FAILED | CANCELLED | TIMEOUT) break ;; esac
        sleep 0.5
    done
    echo "${state}"
}

run_job() {
    local job state
    job="$(sbatch --parsable --time=00:05:00 "$@")"
    state="$(wait_for_job "${job}")"
    if [ "${state}" != "COMPLETED" ]; then
        cat "slurm-${job}.out" >&2 || true
        fail "batch job '$*' ended ${state:-still running}"
    fi
    echo "${job}"
}

# NeSI's seff on a finished job, and NeSI's svisit into a running one
check_nesi_tools() {
    local finished="$1" running state
    [ "$(basename "$(readlink -f "$(command -v seff)")")" = "nn_seff" ] || fail "seff is not NeSI's nn_seff"
    seff "${finished}" > seff.out 2>&1 || { cat seff.out >&2; fail "seff could not report on job ${finished}"; }
    grep -q "^Job ID: ${finished}$" seff.out && grep -q "^Avg CPU Utilisation:" seff.out \
        || { cat seff.out >&2; fail "seff's report on job ${finished} is incomplete"; }
    if [ -n "${2:-}" ]; then
        grep -q "^Peak GPU Utilisation:" seff.out || { cat seff.out >&2; fail "seff has no GPU lines for a GPU job"; }
    fi
    running="$(sbatch --parsable --time=00:05:00 --wrap 'sleep 120')"
    for _ in $(seq 1 60); do
        state="$(sacct -n -j "${running}" | awk '{print $6}')"
        [ "${state}" = "RUNNING" ] && break
        sleep 0.5
    done
    [ "$(svisit "${running}" printenv SLURM_JOB_ID)" = "${running}" ] || fail "svisit did not get into job ${running}"
    svisit -t | grep -q -- "--jobid=${running}" || fail "svisit did not find the running job by itself"
    scancel "${running}"
    ok "NeSI's seff and svisit"
}
{% endif %}

# --- Open OnDemand on k8s -------------------------------------------------
command -v kubectl > /dev/null || fail "kubectl is not installed"
command -v jq > /dev/null || fail "jq is not installed (k8_helper needs it)"
for helper in find_host_port save_passwd_as_secret create_salt_and_sha1 create_passwd; do
    [ -x "/bin/${helper}" ] || fail "/bin/${helper} from training-environment-k8s-utils is missing"
done
ok "kubectl and the ood k8s utils"

# --- the interface --------------------------------------------------------
{% if iface.key == "jupyter" %}
jupyter lab --version > /dev/null || fail "JupyterLab does not run"
ok "JupyterLab $(jupyter lab --version)"
{% elif iface.key == "rstudio" %}
[ -x /usr/lib/rstudio-server/bin/rserver ] || fail "RStudio Server is not installed"
[ -x /usr/lib/rstudio-server/bin/rsession ] || fail "rsession is not installed"
ok "RStudio Server with $(R --version | head -n 1)"
{% else %}
code-server --version > /dev/null || fail "code-server does not run"
ok "code-server $(code-server --version | head -n 1)"
{% for extension in extensions %}
ls /app/code-server/lib/vscode/extensions | grep -qi "^{{ extension.split('@')[0] | replace('.', '\\.') }}-" \
    || fail "the VS Code extension {{ extension }} is not installed"
ok "VS Code extension {{ extension }}"
{% endfor %}
{% endif %}
{% if lmod %}

# --- Lmod -----------------------------------------------------------------
bash -lc 'module --version' > /dev/null 2>&1 || fail "module does not work in a login shell"
bash -c 'type module' > /dev/null 2>&1 || fail "module does not work in scripts (BASH_ENV)"
bash -ic 'type module' > /dev/null 2>&1 || fail "module does not work in interactive shells (/etc/bash.bashrc)"
ok "Lmod: $(bash -lc 'module --version' 2>&1 | grep -o 'Version [0-9.]*' | head -n 1)"
{% endif %}
{% if conda_packages %}

# --- conda software -------------------------------------------------------
[ -s /opt/software/packages.tsv ] || fail "the conda software was not set up"
while IFS=$'\t' read -r name version channel commands module; do
    [ "${name}" = "name" ] && continue
    if [ -z "${commands}" ]; then
        ok "${name} ${version} (no commands)"
        continue
    fi
    first="${commands%% *}"
{% if lmod %}
    found="$(bash -c "module load ${module} && command -v ${first}" < /dev/null)" \
        || fail "module load ${module} does not work"
    case "${found}" in
        /opt/software/*) ;;
        *) fail "after module load ${module}, ${first} is '${found}'" ;;
    esac
    ok "${name} ${version}: module load ${module}"
{% else %}
    command -v "${first}" > /dev/null || fail "${first} (from ${name}) is not on PATH"
    ok "${name} ${version}: ${commands}"
{% endif %}
done < /opt/software/packages.tsv
{% endif %}
{% if pip_packages %}

# --- Python packages ------------------------------------------------------
python3 - << 'EOF' || fail "requested Python packages are not installed"
import importlib.metadata as metadata
import re
import sys

missing = []
for line in open("/opt/app-creator/requirements.txt", encoding="utf-8"):
    line = line.split("#", 1)[0].strip()
    if not line or line.startswith(("-", "git+")):
        continue
    name = re.split(r"[\s\[<>=!~;@]", line, maxsplit=1)[0]
    try:
        metadata.distribution(name)
    except metadata.PackageNotFoundError:
        missing.append(name)
if missing:
    print("not installed:", ", ".join(missing), file=sys.stderr)
    sys.exit(1)
EOF
ok "Python packages: {{ pip_packages | join(', ') }}"
{% endif %}
{% if gpu.enabled %}

# --- emulated GPUs and Slurm ----------------------------------------------
gpuemu-ctl start > /dev/null
nvidia-smi -L || fail "nvidia-smi cannot see the emulated GPUs"
cd "${work}"
job="$(run_job --gpus-per-node={{ gpu.cards[0] }}:1 --wrap 'nvidia-smi -L')"
grep -q "GPU 0" "slurm-${job}.out" || fail "a batch job that asked for a GPU could not see it"
check_nesi_tools "${job}" gpu
{% if lmod %}
run_job --wrap 'module --version' > /dev/null
ok "module works inside batch jobs"
{% endif %}
{% if gpu.pytorch %}
python3 -c "import torch; assert torch.cuda.is_available(), 'no CUDA'; print(torch.cuda.get_device_name(0))" \
    || fail "torch.cuda does not see the emulated GPU"
{% endif %}
gpuemu-ctl stop > /dev/null
ok "emulated GPUs: $(sinfo -l -h | awk '{print $NF}'), and a GPU batch job ran"
{% elif slurm.enabled %}

# --- Slurm emulator -------------------------------------------------------
slurm-emulator start > /dev/null
sinfo | grep -q "^{{ slurm.partition }}\*" || fail "sinfo does not show the {{ slurm.partition }} partition"
cd "${work}"
job="$(run_job --wrap 'echo "job ${SLURM_JOB_ID} ran on ${SLURMD_NODENAME}"')"
grep -q "ran on {{ slurm.node_name }}" "slurm-${job}.out" || fail "the batch job did not run on {{ slurm.node_name }}"
check_nesi_tools "${job}"
if sbatch --gpus-per-node=1 --wrap true 2> /dev/null; then
    fail "a GPU request was accepted on a node with no GPUs"
fi
{% if lmod %}
run_job --wrap 'module --version' > /dev/null
ok "module works inside batch jobs"
{% endif %}
slurm-emulator stop > /dev/null
ok "Slurm emulator: partition {{ slurm.partition }}, node {{ slurm.node_name }}"
{% endif %}
{% if gpu.enabled or slurm.enabled %}

# leave no build-time state behind: learners start with an empty queue, and a
# root-owned file here would stop them submitting jobs
cd /
rm -rf /run/gpuemu
install -d -m 1777 /run/gpuemu /run/gpuemu/slurm /run/gpuemu/slurm/jobs{% if gpu.enabled %} /run/gpuemu/claims{% endif %}

{% endif %}
{% if data %}

# --- workshop data --------------------------------------------------------
{% for item in data %}
[ -n "$(ls -A /opt/training-data/{{ item.dest }} 2> /dev/null)" ] || fail "~/{{ item.dest }} would be empty"
{% endfor %}
ok "data for $(cd /opt/training-data && echo */ | tr -d /)"
{% endif %}

echo "smoke-test: all checks passed"
