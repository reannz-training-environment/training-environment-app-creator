# run unminimise, e.g. for man pages to work
RUN yes | unminimize

# install system dependencies; ldap-utils, libnss-ldapd, libpam-ldapd, nscd and
# nslcd make the container resolve the training users from the environment's LDAP
RUN echo 'tzdata tzdata/Areas select {{ tz_area }}' | debconf-set-selections \
    && echo 'tzdata tzdata/Zones/{{ tz_area }} select {{ tz_zone }}' | debconf-set-selections \
    && apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y \
        bash-completion \
        bzip2 \
        ca-certificates \
        curl \
        dnsutils \
        file \
        git \
        jq \
        ldap-utils \
        less \
        libnss-ldapd \
        libpam-ldapd \
        locales \
        man-db \
        nano \
        nodejs \
        nscd \
        nslcd \
        python-is-python3 \
        python3 \
        python3-dev \
        python3-pip \
        python3-venv \
        rsync \
        tree \
        tzdata \
        unzip \
        vim \
        wget \
        xz-utils \
        zip \
    && rm -rf /var/lib/apt/lists/* \
    && localedef -i en_NZ -c -f UTF-8 -A /usr/share/locale/locale.alias en_NZ.UTF-8

ENV LANG=en_NZ.utf8

# Ubuntu 22.04 ships pip 22 and setuptools 59, which predate packages that are
# described only by pyproject.toml; upgrade them before installing anything else
RUN pip3 --no-cache-dir install --upgrade pip 'setuptools>=64' wheel
